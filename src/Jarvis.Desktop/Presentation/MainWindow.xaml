<Window x:Class="Jarvis.Desktop.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis — Asistent și tutore"
        Width="720" Height="640" MinWidth="500" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="15"
        Background="#F3F6FA" Foreground="#172B43"
        UseLayoutRounding="True">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Jarvis" FontSize="32" FontWeight="SemiBold" />
                <TextBlock Text="Asistent și tutore pentru desktop" Foreground="#52647A" Margin="0,5,12,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#E1F3EA" CornerRadius="14" Padding="14,7" VerticalAlignment="Top" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#226B4A" Margin="0,0,7,0" />
                    <TextBlock Text="Gata" Foreground="#205C41" FontWeight="SemiBold"
                               AutomationProperties.AutomationId="AssistantStatus"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="White" CornerRadius="12" Padding="24" BorderBrush="#DCE3EC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Bine ai venit!" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Margin="0,12,0,0" Foreground="#40546B" LineHeight="24"
                                   Text="Jarvis este la început. În această versiune poți deschide și închide aplicația. Funcțiile de asistență vor fi adăugate în etapele următoare." />
                        <Border Background="#EEF4FC" CornerRadius="8" Padding="16" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Tu alegi când începe asistența" FontWeight="SemiBold" />
                                <TextBlock Margin="0,7,0,0" Foreground="#40546B" LineHeight="23"
                                           Text="Acum microfonul este oprit, ecranul nu este capturat și nu se trimite nimic către servicii AI." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock Margin="4,20,4,0" FontWeight="SemiBold" Text="Versiune inițială · Etapa 0" />
                <TextBlock Margin="4,8,4,16" Foreground="#52647A" LineHeight="23"
                           Text="Conversațiile, comanda rapidă, explicațiile vocale și adnotările pe ecran nu sunt disponibile încă. Nu este necesară nicio configurare." />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Închiderea ferestrei oprește aplicația." Foreground="#52647A"
                       FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0" />
            <Button Grid.Column="1" Content="Închide" Click="CloseButton_Click"
                    AutomationProperties.AutomationId="CloseApplicationButton" />
        </Grid>
    </Grid>
</Window>
